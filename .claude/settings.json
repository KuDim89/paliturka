{
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-write-guard.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": ["Bash(git commit:*)", "PowerShell(git commit:*)"],
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git add -- .)",
      "Bash(git add * .)",
      "Bash(git add ./)",
      "Bash(git add -- ./)",
      "Bash(git add * ./)",
      "Bash(git add :/*)",
      "Bash(git add * :/*)",
      "Bash(git add -u:*)",
      "Bash(git add --update:*)",
      "Bash(git add * -A*)",
      "Bash(git add * --all*)",
      "Bash(git add * -u*)",
      "Bash(git add * --update*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --amend:*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * --amend*)",
      "Bash(git commit -a:*)",
      "Bash(git commit --all:*)",
      "Bash(git commit * -a *)",
      "Bash(git commit * -a)",
      "Bash(git commit * --all*)"
    ]
  }
}
